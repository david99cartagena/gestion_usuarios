                    ¿Ya tienes cuenta? Inicia sesión
                </a>
            </div>
            {% endif %}

        </div>
    </div>
</div>
<script>
    function togglePassword() {
        const passwordField = document.getElementById("password_field");
        const toggleBtn = document.getElementById("toggle_password_btn");

        if (passwordField.type === "password") {
            passwordField.type = "text";
            toggleBtn.textContent = "🙈";
        } else {
            passwordField.type = "password";
            toggleBtn.textContent = "👁";
        }
    }
</script>
{% endblock %} #}

{% extends 'base.html.twig' %}
{% block title %}
{{ is_edit ? 'Editar Perfil' : 'Registro' }}
{% endblock %}
{% block body %}
<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-sm">
        <div class="card-body">

            <h3 class="text-center mb-4">
                {{ is_edit ? 'Editar Perfil' : 'Crear Cuenta' }}
            </h3>
            {{ form_start(form, {'attr': {'onsubmit': 'disableButton()'}}) }}
            
            {# Nombre #}
            <div class="mb-3">
                {{ form_label(form.nombre) }}
                {{ form_widget(form.nombre, {
                'attr': {
                'class': 'form-control',
                'placeholder': 'Tu nombre'
                }
                }) }}
                <div class="text-danger small">
                    {{ form_errors(form.nombre) }}
                </div>
            </div>

            {# Email #}
            <div class="mb-3">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, {
                'attr': {
                'class': 'form-control',
                'placeholder': 'nombre@ejemplo.com'
                }
                }) }}
                <div class="text-danger small">
                    {{ form_errors(form.email) }}
                </div>
            </div>

            {# Contraseña #}
            <div class="mb-3">
                {{ form_label(form.plainPassword) }}
                <div class="input-group">
                    {{ form_widget(form.plainPassword, {
                    'attr': {
                    'class': 'form-control',
                    'id': 'password_field',
                    'placeholder':
                    is_edit
                    ? 'Nueva contraseña (opcional)'
                    : 'Contraseña'
                    }
                    }) }}
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()"
                        id="toggle_password_btn">👁
                    </button>
                </div>

                {# Error bonito #}
                <div class="text-danger small mt-1">
                    {{ form_errors(form.plainPassword) }}
                </div>

                {# Requisitos contraseña #}
                <small class="text-muted">
                    La contraseña debe tener:
                    <br>✔ Mínimo 6 caracteres
                    <br>✔ Una mayúscula
                    <br>✔ Un número
                </small>
            </div>


            {# Terminos solo registro #}
            {% if not is_edit %}
            <div class="form-check mb-4">
                {{ form_widget(form.agreeTerms,{
                'attr':{
                'class':'form-check-input'
                }
                }) }}

                {{ form_label(
                form.agreeTerms,
                'Acepto los términos y condiciones',
                {'label_attr':{
                'class':'form-check-label'
                }}
                )}}

                <div class="text-danger small">
                    {{ form_errors(form.agreeTerms) }}
                </div>
            </div>
            {% endif %}


            {# Boton submit #}
            <button type="submit" class="btn btn-success w-100" id="submitBtn">
                {{ is_edit ? 'Actualizar Perfil' : 'Registrarse' }}
            </button>

            {{ form_end(form) }}

            {% if not is_edit %}
            <hr class="mt-4">
            <div class="text-center">
                <a href="{{ path('app_login') }}" class="text-decoration-none small">¿Ya tienes cuenta? Inicia sesión</a>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
    function togglePassword() {

        const passwordField = document.getElementById("password_field");
        const toggleBtn = document.getElementById("toggle_password_btn");

        if (passwordField.type === "password") {
            passwordField.type = "text";
            toggleBtn.textContent = "🙈";
        } else {
            passwordField.type = "password";
            toggleBtn.textContent = "👁";
        }
    }

    function disableButton() {
        const btn = document.getElementById("submitBtn");
        btn.disabled = true;
        btn.innerText = "Guardando...";
    }
</script>

{% endblock %}