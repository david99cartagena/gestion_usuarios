<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Gestión Usuarios
			{% endblock %}
		</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	</head>
	<body>
		<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
			<div
				class="container">
				{# <a class="navbar-brand" href="{{ path('app_login') }}"> #}
				<a class="navbar-brand" href="{{ path('app_home') }}">Gestión Usuarios</a>
				<div>
					{% if app.user %}
						<a class="btn btn-outline-light btn-sm" href="{{ path('app_profile') }}">Perfil</a>
						<a class="btn btn-danger btn-sm" href="{{ path('app_logout') }}">Cerrar sesión</a>
					{% else %}
						<a class="btn btn-outline-light btn-sm" href="{{ path('app_login') }}">Login</a>
						<a class="btn btn-success btn-sm" href="{{ path('app_register') }}">Registro</a>
					{% endif %}
				</div>
			</div>
		</nav>
		
        <div class="container mt-4"> {% block body %}{% endblock %}</div>
        
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        {# Flash Messages con SweetAlert #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <script>
                    Swal.fire({
                        icon: '{{ label }}',
                        title: '{{ label == "success" ? "Éxito" : (label == "error" ? "Error" : "Aviso") }}',
                        text: '{{ message }}',
                        timer: 2500,
                        showConfirmButton: false
                    });
                </script>
            {% endfor %}
        {% endfor %}

	</body>
</html>
