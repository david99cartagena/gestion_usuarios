{% extends 'base.html.twig' %}

{% block title %}Mi Perfil{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card shadow" style="max-width: 600px; margin: auto;">
        <div class="card-body">
            <h3 class="text-center mb-4">Mi Perfil</h3>

            <div class="row mb-4">
                <div class="col-sm-4 text-muted">Nombre:</div>
                <div class="col-sm-8 fw-bold">{{ app.user.nombre }}</div>

                <div class="col-sm-4 text-muted mt-2">Email:</div>
                <div class="col-sm-8 fw-bold mt-2">{{ app.user.email }}</div>

                <div class="col-sm-4 text-muted mt-2">Estado:</div>
                <div class="col-sm-8 mt-2">
                    {% if app.user.isActive %}
                        <span class="badge bg-success">Activo</span>
                    {% else %}
                        <span class="badge bg-danger">Inactivo</span>
                    {% endif %}
                </div>
            </div>

            <hr>

            <div class="row g-2">
                <div class="col-6">
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary w-100">
                        Editar Perfil
                    </a>
                </div>

                <div class="col-6">
                    {% if app.user.isActive %}
                        <form id="deactivate-form" 
                              action="{{ path('app_profile_deactivate') }}" 
                              method="post">
                              
                            <input type="hidden" name="_token" 
                                   value="{{ csrf_token('deactivate-profile') }}">
                                   
                            <button type="button" 
                                    class="btn btn-outline-danger w-100"
                                    onclick="confirmDeactivate()">
                                Desactivar
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>
</div>

<script>
function confirmDeactivate() {
    Swal.fire({
        title: '¿Estás seguro?',
        text: 'Tu cuenta será desactivada y no podrás iniciar sesión.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Sí, desactivar',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            document.getElementById('deactivate-form').submit();
        }
    });
}
</script>

{% endblock %}
